{
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "training": {
    "lr": 2e-6,
    "betas": [0.9,0.999],
    "eps": 1e-8,
    "weight_decay": 0.01,
    "amsgrad": false,
    "epochs": 1,
    "batch_size": 8,
    "model": "Qwen/Qwen3-TTS-12Hz-0.6B-Base",
    "model_path": "./model",
    "tokenizer": "Qwen/Qwen3-TTS-Tokenizer-12Hz",
    "tokenizer_path": "./tokenizer",
    "attn_implementation": "sdpa",
    "speaker_name": "Test Speaker",
    "gradient_accumulation_steps": 2,
    "enable_experiment_tracking": true,
    "model_checkpoint": {
      "save_every_n_epochs": 1,
      "output_path": "output/model",
      "upload_to_hub": false,
      "upload_every_n_epochs": 1,
      "repo_id": "test/model",
      "private": false,
      "revision": "main",
      "path_in_repo": ".",
      "commit_message": "Upload checkpoint Epoch {epoch} Steps {global_step}"
    },
    "training_checkpoint": {
      "save_every_n_epochs": 1,
      "output_path": "output/train",
      "upload_to_hub": false,
      "upload_every_n_epochs": 1,
      "repo_id": "test/train",
      "private": false,
      "revision": "main",
      "path_in_repo": ".",
      "commit_message": "Upload checkpoint Epoch {epoch} Steps {global_step}"
    },
    "resume_training_path": ""
  },
  "dataset": {
    "dataset": "rijulpaul/genshin-voice",
    "subset": "subset",
    "train_split": "train",
    "test_split": "test",
    "local_path": ".",
    "audio_column": "audio",
    "transcript_column": "transcription",
    "speaker_column": "speaker",
    "speaker_name": "Paimon",
    "is_processed": false
  },
  "process": {
    "top_db_to_trim": 30,
    "target_sample_rate": 24000,
    "select_ref_audio_strategy": "random",
    "ref_audio_min_duration": 5,
    "ref_audio_max_duration": 15
  },
  "wandb": {
    "project":"test",
    "entity":"test",
    "run_name":"test run",
    "mode":"offline",
    "log_every_n_steps": 50
  },
  "testing": {
    "word_error_rate": true,
    "speaker_similarity": true,
    "save_samples": true,
    "output_path": "./samples/{epoch}"
  }
}
